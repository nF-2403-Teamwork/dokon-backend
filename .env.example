PORT=5000
MONGO_URI=mongodb://localhost:27017/dokon-2
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of origins allowed to call the API / connect via socket.io
CLIENT_ORIGIN=http://localhost:5173
# Groq API key for the AI assistant page — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Telegram bot token from @BotFather — leave blank to disable the bot entirely
TELEGRAM_BOT_TOKEN=
# Fixed chat id that shift start/end pings go to (see services/telegram.js's
# notifyOwnerChat). Set per-deployment. Leave blank to skip these
# notifications entirely.
TELEGRAM_OWNER_CHAT_ID=
